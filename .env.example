# Copy to .env and fill in as needed.

NODE_ENV=development

# OAuth application identifier. Leave the entire OAuth block empty when OAuth is disabled.
VITE_APP_ID=

# Optional comma-separated additional hostnames allowed to access the Vite dev server.
# Localhost and 127.0.0.1 are always allowed. Do not include URL schemes or paths.
PEOPLES_VITE_ALLOWED_HOSTS=

# Use a cryptographically random secret of at least 32 bytes in production.
JWT_SECRET=change-me-in-production

# PostgreSQL (e.g. Neon) — required for visitor analytics, inquiries, preferences, timeline
# Use the pooled connection string from Neon; `channel_binding` is stripped at runtime for node-pg.
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# H.K. Assistant (Anthropic Claude)
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Owner email alerts when key sections are first visited + inquiry notifications
OWNER_NOTIFY_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OAuth (optional as a complete block; production fails closed if only part is configured)
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
FRONTEND_URL=
OWNER_OPEN_ID=

# Optional: Forge APIs
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
