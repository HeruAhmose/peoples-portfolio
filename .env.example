# Copy to .env and fill in as needed for auth, DB, and optional Forge/Manus APIs.

NODE_ENV=development

# Client (Vite)
VITE_APP_ID=

# Server — JWT for session cookies
JWT_SECRET=change-me-in-production

# MySQL (Drizzle) — optional for local dev if app runs without DB features
DATABASE_URL=mysql://user:password@127.0.0.1:3306/peoples_portfolio

# OAuth (if using built-in auth flows)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional: Forge / external APIs
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
