# Copy to .env and fill in as needed.

NODE_ENV=development

VITE_APP_ID=

JWT_SECRET=change-me-in-production

# MySQL — required for visitor analytics, inquiries, preferences, timeline
DATABASE_URL=mysql://user:password@127.0.0.1:3306/peoples_portfolio

# H.K. Assistant (Anthropic Claude)
ANTHROPIC_API_KEY=
# Optional override (default: claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Owner email alerts when key sections are first visited + inquiry notifications
OWNER_NOTIFY_EMAIL=you@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# OAuth (optional)
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# Optional: Forge / Manus APIs
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
